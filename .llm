type = "static-library"
name = "lzma"
standards = ["C11"]

[includes]
private = ["src/liblzma/common", "src/liblzma/check", "src/liblzma/lz", "src/liblzma/rangecoder", "src/liblzma/lzma", "src/liblzma/delta", "src/liblzma/simple", "src/common"]

[defines]
public = ["LZMA_API_STATIC"]
private = ["HAVE_CHECK_CRC32=1", "HAVE_CHECK_CRC64=1", "HAVE_CHECK_SHA256=1", "HAVE_DECODERS=1", "HAVE_DECODER_ARM=1", "HAVE_DECODER_ARM64=1", "HAVE_DECODER_ARMTHUMB=1", "HAVE_DECODER_DELTA=1", "HAVE_DECODER_IA64=1", "HAVE_DECODER_LZMA1=1", "HAVE_DECODER_LZMA2=1", "HAVE_DECODER_POWERPC=1", "HAVE_DECODER_RISCV=1", "HAVE_DECODER_SPARC=1", "HAVE_DECODER_X86=1", "HAVE_ENCODERS=1", "HAVE_ENCODER_ARM=1", "HAVE_ENCODER_ARM64=1", "HAVE_ENCODER_ARMTHUMB=1", "HAVE_ENCODER_DELTA=1", "HAVE_ENCODER_IA64=1", "HAVE_ENCODER_LZMA1=1", "HAVE_ENCODER_LZMA2=1", "HAVE_ENCODER_POWERPC=1", "HAVE_ENCODER_RISCV=1", "HAVE_ENCODER_SPARC=1", "HAVE_ENCODER_X86=1", "HAVE_FUNC_ATTRIBUTE_CONSTRUCTOR=1", "HAVE_INTTYPES_H=1", "HAVE_LZIP_DECODER=1", "HAVE_MF_BT2=1", "HAVE_MF_BT3=1", "HAVE_MF_BT4=1", "HAVE_MF_HC3=1", "HAVE_MF_HC4=1", "HAVE_STDBOOL_H=1", "HAVE_STDINT_H=1", "HAVE__BOOL=1", "HAVE___BUILTIN_ASSUME_ALIGNED=1", "HAVE___BUILTIN_BSWAPXX=1", "TUKLIB_SYMBOL_PREFIX=lzma_", "TUKLIB_FAST_UNALIGNED_ACCESS=1"]

[windows.defines]
private = ["MYTHREAD_VISTA", "_WIN32_WINNT=0x0600", "_CRT_SECURE_NO_WARNINGS"]

[linux]
libraries = ["pthread"]

[linux.defines]
private = ["MYTHREAD_POSIX", "_GNU_SOURCE", "HAVE_CLOCK_GETTIME=1", "HAVE_PTHREAD_CONDATTR_SETCLOCK=1", "TUKLIB_PHYSMEM_SYSCONF=1", "TUKLIB_CPUCORES_SYSCONF=1"]

[macos]
libraries = ["pthread"]

[macos.defines]
private = ["MYTHREAD_POSIX", "_DARWIN_C_SOURCE", "HAVE_CLOCK_GETTIME=1", "TUKLIB_PHYSMEM_SYSCTL=1", "TUKLIB_CPUCORES_SYSCTL=1", "HAVE_SYS_PARAM_H=1"]
